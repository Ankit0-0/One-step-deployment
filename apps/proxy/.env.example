# apps/proxy — validated by proxyEnvSchema in packages/config.
NODE_ENV=development
LOG_LEVEL=info
PORT=8000

DATABASE_URL=postgresql://osd:change-me-postgres@localhost:5432/osd?schema=public
REDIS_URL=redis://:change-me-redis@localhost:6379

# Sites are served at {slug}.{ROOT_DOMAIN}; *.localhost resolves locally in most browsers.
ROOT_DOMAIN=localhost
CACHE_TTL_SECONDS=30

STORAGE_DRIVER=minio
STORAGE_BUCKET=osd-deployments
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=osdminio
S3_SECRET_ACCESS_KEY=change-me-minio
S3_REGION=us-east-1
