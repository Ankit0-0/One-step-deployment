# infra/aws/ec2 — compose variables for the EC2 host. Copy to .env.
ROOT_DOMAIN=example.dev
ACME_EMAIL=ops@example.dev
AWS_REGION=ap-south-1
ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=v1
# Private IP of this instance; Fargate build workers connect to Redis here.
PRIVATE_IP=10.0.1.10
# Generate with: openssl rand -hex 32. Also store redis://:<password>@<PRIVATE_IP>:6379 in SSM
# as the SecureString parameter /osd/worker/REDIS_URL for the build workers.
REDIS_PASSWORD=change-me
