{
  "name": "@osd/build-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@osd/config": "workspace:*",
    "@osd/shared": "workspace:*",
    "@osd/storage": "workspace:*",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@osd/eslint-config": "workspace:*",
    "@osd/tsconfig": "workspace:*",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "pino": "^9.14.0"
  }
}
