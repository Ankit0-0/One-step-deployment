# infra/aws/ec2 — proxy settings. Copy to proxy.env. REDIS_URL is set by docker-compose.yml.
NODE_ENV=production
LOG_LEVEL=info
PORT=8000
DATABASE_URL=postgresql://osd:change-me@osd.xxxxxx.ap-south-1.rds.amazonaws.com:5432/osd?schema=public&sslmode=require
ROOT_DOMAIN=example.dev
CACHE_TTL_SECONDS=30
TRUST_PROXY=true
METRICS_TOKEN=replace-with-a-long-random-token

STORAGE_DRIVER=s3
STORAGE_BUCKET=my-osd-sites
AWS_REGION=ap-south-1
