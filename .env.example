# Root env used by infra/docker-compose.yml and local tooling.
# Copy to .env and adjust. Never commit real secrets.

# Postgres
POSTGRES_USER=osd
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=osd
DATABASE_URL=postgresql://osd:change-me-postgres@localhost:5432/osd?schema=public

# Redis (password required)
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@localhost:6379

# MinIO (S3-compatible local storage)
MINIO_ROOT_USER=osdminio
MINIO_ROOT_PASSWORD=change-me-minio
STORAGE_BUCKET=osd-deployments

# Domains
ROOT_DOMAIN=localhost
WEB_ORIGIN=http://localhost:3000
