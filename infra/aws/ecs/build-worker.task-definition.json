{
  "family": "osd-build-worker",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "1024",
  "memory": "2048",
  "ephemeralStorage": { "sizeInGiB": 30 },
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/osd-build-worker-task",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/osd-build-worker-execution",
  "containerDefinitions": [
    {
      "name": "build-worker",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/osd/build-worker:${IMAGE_TAG}",
      "essential": true,
      "user": "node",
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "STORAGE_DRIVER", "value": "s3" },
        { "name": "STORAGE_BUCKET", "value": "${BUCKET}" },
        { "name": "AWS_REGION", "value": "${AWS_REGION}" },
        { "name": "BUILD_TIMEOUT_MS", "value": "600000" },
        { "name": "MAX_OUTPUT_BYTES", "value": "524288000" },
        { "name": "WORK_DIR", "value": "/tmp/osd-build" }
      ],
      "secrets": [
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter/osd/worker/REDIS_URL"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/osd-build-worker",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "build"
        }
      }
    }
  ]
}
