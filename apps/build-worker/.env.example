# apps/build-worker — validated by workerEnvSchema in packages/config.
# The api runner injects DEPLOYMENT_ID, GIT_URL and REQUEST_ID per build.
# The worker has NO database credentials by design.
NODE_ENV=development
LOG_LEVEL=info

REDIS_URL=redis://:change-me-redis@localhost:6379

DEPLOYMENT_ID=
GIT_URL=
REQUEST_ID=

BUILD_TIMEOUT_MS=600000
MAX_OUTPUT_BYTES=524288000
WORK_DIR=/tmp/osd-build

STORAGE_DRIVER=minio
STORAGE_BUCKET=osd-deployments
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=osdminio
S3_SECRET_ACCESS_KEY=change-me-minio
S3_REGION=us-east-1
