# apps/api — validated by apiEnvSchema in packages/config. Copy to .env.
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000

DATABASE_URL=postgresql://osd:change-me-postgres@localhost:5432/osd?schema=public
REDIS_URL=redis://:change-me-redis@localhost:6379

WEB_ORIGIN=http://localhost:3000
ROOT_DOMAIN=localhost
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=604800
# Set to false only for plain-http local development.
COOKIE_SECURE=false
TRUST_PROXY=false
MAX_CONCURRENT_BUILDS_PER_USER=2

# Email: console (logs the login code) | resend
EMAIL_DRIVER=console
# RESEND_API_KEY=
# EMAIL_FROM=Deploy <login@example.com>

# Storage: minio | s3
STORAGE_DRIVER=minio
STORAGE_BUCKET=osd-deployments
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=osdminio
S3_SECRET_ACCESS_KEY=change-me-minio
S3_REGION=us-east-1
# For STORAGE_DRIVER=s3 set AWS_REGION and use the AWS credential chain instead of keys.

# Build runner: docker (local) | ecs
BUILD_RUNNER=docker
BUILD_WORKER_IMAGE=osd/build-worker:local
# DOCKER_NETWORK=osd_default
# For BUILD_RUNNER=ecs:
# AWS_REGION=ap-south-1
# ECS_CLUSTER=osd-builds
# ECS_TASK_DEFINITION=osd-build-worker
# ECS_CONTAINER_NAME=build-worker
# ECS_SUBNETS=subnet-aaa,subnet-bbb
# ECS_SECURITY_GROUPS=sg-ccc
# ECS_ASSIGN_PUBLIC_IP=true
