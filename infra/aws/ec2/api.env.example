# infra/aws/ec2 — api settings. Copy to api.env. REDIS_URL is set by docker-compose.yml.
NODE_ENV=production
LOG_LEVEL=info
PORT=4000
DATABASE_URL=postgresql://osd:change-me@osd.xxxxxx.ap-south-1.rds.amazonaws.com:5432/osd?schema=public&sslmode=require
WEB_ORIGIN=https://app.example.dev
ROOT_DOMAIN=example.dev
# openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
TRUST_PROXY=true
MAX_CONCURRENT_BUILDS_PER_USER=2
# "Login as guest": throwaway accounts deleted with all their data after the TTL (default 24h).
GUEST_LOGIN_ENABLED=true
GUEST_TTL_SECONDS=86400
GUEST_MAX_PROJECTS=3
BUILD_TIMEOUT_MS=600000
METRICS_TOKEN=replace-with-a-long-random-token

EMAIL_DRIVER=resend
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Deploy <login@example.dev>

STORAGE_DRIVER=s3
STORAGE_BUCKET=my-osd-sites
AWS_REGION=ap-south-1

BUILD_RUNNER=ecs
ECS_CLUSTER=osd
ECS_TASK_DEFINITION=osd-build-worker
ECS_CONTAINER_NAME=build-worker
ECS_SUBNETS=subnet-aaa,subnet-bbb
ECS_SECURITY_GROUPS=sg-build-workers
ECS_ASSIGN_PUBLIC_IP=true
